    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.67.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "motion": "^14.9.0",
    "multer": "^2.5.0",
